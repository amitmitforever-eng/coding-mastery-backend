# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Used to build the password reset link returned/emailed to users.
FRONTEND_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coding-mastery

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin registration. Required by anyone who picks "Admin" on the register
# form. Keep this secret - rotate it whenever someone leaves the team.
ADMIN_REGISTRATION_CODE=CM-ADMIN-2026

# Allow admins to wipe all users/courses from the admin dashboard (dev/testing).
# Defaults to enabled when NODE_ENV=development.
ALLOW_DEV_RESET=true

# Email (SMTP). Leave SMTP_HOST blank to log emails to the server console
# instead of sending them (useful in development).
# Examples:
#   Gmail (App Password):  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   Mailtrap (testing):    SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
#   Brevo / SendGrid SMTP: their own host/port
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Coding Mastery <no-reply@codingmastery.local>

# YouTube Data API v3 (powers the Videos page playlists). Get a free key at
# https://console.cloud.google.com/ -> APIs & Services -> Library ->
# "YouTube Data API v3" -> Enable -> Credentials -> Create API key.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=codingmasterywithamit
# Optional: set this directly to skip the handle->id lookup (saves quota).
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@codingmasterywithamit
